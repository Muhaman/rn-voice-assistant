  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.0",
    "eslint": "^10.13.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.0",
